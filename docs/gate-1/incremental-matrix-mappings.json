      "level": "level'=sign*level",
      "dual": "pi'=sign*pi"
    },
    "ranged_row_split": {
      "equality_rows_may_split": false,
      "lower_multiplier": "lambda_L=max(-pi,0)",
      "upper_multiplier": "lambda_U=max(pi,0)",
      "dual_reconstruction": "pi=lambda_U-lambda_L"
    },
    "auxiliary_elimination": {
