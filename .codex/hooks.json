{
  "description": "Probity TDD guardrails for the pySPD Python project.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "npm exec --no -- probity --agent codex",
            "statusMessage": "Checking pySPD TDD guardrails"
          }
        ]
      }
    ]
  }
}
