{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyspd.example/schemas/tdd-evidence-1.0.0.json",
  "title": "PySPD auditable red/green TDD evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "requirement_ids",
    "production_paths",
    "parent_commit",
    "test_patch_sha256",
    "test_files",
    "command",
    "package_manager",
    "environment_manifest_sha256",
    "red",
    "green",
    "author",
    "reviewer"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^TDD-[A-Z0-9][A-Z0-9._-]+$"
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "production_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(src|pyspd|tests|tools)/"
      }
    },
    "parent_commit": {
      "$ref": "#/$defs/gitSha"
    },
    "implementation_commit": {
      "anyOf": [
        {
          "$ref": "#/$defs/gitSha"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "test_patch_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "test_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^tests/"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "command": {
      "type": "string",
      "minLength": 6,
      "description": "Exact non-interactive command; Python commands must begin with uv run."
    },
    "package_manager": {
      "enum": [
        "uv",
        "npm"
      ]
    },
    "environment_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "red": {
      "allOf": [
        {
          "$ref": "#/$defs/run"
        },
        {
          "type": "object",
          "required": [
            "expected_failure_fingerprint"
          ],
          "properties": {
            "exit_code": {
              "type": "integer",
              "not": {
                "const": 0
              }
            },
            "expected_failure_fingerprint": {
              "type": "string",
              "minLength": 8,
              "description": "Assertion/error fingerprint proving behavioral failure, not lint/import/environment failure."
            }
          }
        }
      ]
    },
    "green": {
      "allOf": [
        {
          "$ref": "#/$defs/run"
        },
        {
          "type": "object",
          "properties": {
            "exit_code": {
              "const": 0
            }
          }
        }
      ]
    },
    "author": {
      "$ref": "#/$defs/person"
    },
    "reviewer": {
      "$ref": "#/$defs/person"
    },
    "exception": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "approver",
            "expires_at",
            "follow_up_test"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 20
            },
            "approver": {
              "$ref": "#/$defs/person"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "follow_up_test": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      ],
      "default": null
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "exit_code",
        "output_sha256",
        "duration_seconds"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "exit_code": {
          "type": "integer"
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "expected_failure_fingerprint": {
          "type": "string",
          "minLength": 8
        },
        "log_uri": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
